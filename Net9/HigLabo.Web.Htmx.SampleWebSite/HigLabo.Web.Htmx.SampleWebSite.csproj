<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	  <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
      <!-- Both frameworks emit TypeScript into the same wwwroot directory. -->
      <BuildInParallel>false</BuildInParallel>
	  <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	  <Version>10.0.0.0</Version>
	  <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	  <Company>HigLabo</Company>
	  <Authors>Higty</Authors>
	  <Copyright>Copyright © 2011- HigLabo All Rights Reserved</Copyright>
	  <RepositoryUrl>https://github.com/higty/higlabo</RepositoryUrl>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HigLabo.Web\HigLabo.Web.csproj" />
  </ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.TypeScript.MSBuild" Version="5.7.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

  <!-- Generate JavaScript before the SDK fingerprints static web assets, including after Clean. -->
  <Target Name="CompileTypeScriptBeforeStaticWebAssets"
          BeforeTargets="ResolveProjectStaticWebAssets"
          Condition="'$(TargetFramework)' != '' And '$(DesignTimeBuild)' != 'true'"
          DependsOnTargets="CheckFileSystemCaseSensitive;FindConfigFiles;TypeScriptDeleteOutputFromOtherConfigs;CompileTypeScript;CompileTypeScriptWithTSConfig;GetTypeScriptOutputForPublishing" />
</Project>
